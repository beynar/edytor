{
	"$schema": "node_modules/wrangler/config-schema.json",
	// The public collaboration room behind the docs' live editor.
	"name": "edytor-room",
	"account_id": "6886250e2aff0047919a1ed731a55c64",
	"main": "src/worker.ts",
	"compatibility_date": "2026-09-26",
	"durable_objects": {
		"bindings": [{ "name": "ROOMS", "class_name": "DocumentRoom" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocumentRoom"] }],
	// The rooms' version history (H11): two versions a day, kept 30 days.
	"kv_namespaces": [{ "binding": "HISTORY", "id": "fecd8d9e405641b98ef763bb6056af08" }],
	"vars": {
		// Origins allowed to open a socket, besides localhost.
		"ALLOWED_ORIGINS": "https://edytor.dev,https://edytor-docs.beynar.workers.dev"
	},
	"observability": { "enabled": true }
}
