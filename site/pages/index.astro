---
import data from "blume:data";
import PageLayout from "blume/components/layout/PageLayout.astro";
import CallToAction from "./_home/CallToAction.astro";
import Capabilities from "./_home/Capabilities.astro";
import CodePreview from "./_home/CodePreview.astro";
import Features from "./_home/Features.astro";
import Footer from "./_home/Footer.astro";
import Hero from "./_home/Hero.astro";
import LivePreview from "./_home/LivePreview.astro";

const { config } = data;
const pageTitle = "Edytor — the collaborative block editor for Svelte";
const pageDescription =
  "Notion-style blocks for Svelte 5, plugins that can veto any edit, and real-time collaboration on a Yjs v14 engine with a Cloudflare Durable Object server.";
---

<PageLayout
  analytics={config.analytics}
  banner={config.banner}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  logo={config.logo}
  navigation={data.navigation}
  ogEnabled={config.og.enabled}
  page={{ description: pageDescription, route: "/", title: pageTitle }}
  searchEnabled={config.search.enabled}
  site={{ description: config.description, title: config.title }}
  siteUrl={config.site}
  themeMode={config.theme.mode}
>
  <div
    class="mx-auto grid max-w-[1400px] gap-20 px-6 py-20 sm:py-24 lg:gap-28 xl:gap-32"
  >
    <Hero />
    <LivePreview />
    <Features />
    <CodePreview />
    <Capabilities />
    <CallToAction />
  </div>
  <Footer slot="footer" />
</PageLayout>
