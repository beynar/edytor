---
import Icon from "blume/components/Icon.astro";
import LiveEditor from "../../islands/LiveEditor.svelte";
---

<section>
  <div class="rounded-[2rem] bg-muted/50 p-3 sm:p-8 lg:p-12">
    <div class="mx-auto max-w-4xl">
      <LiveEditor client:only="svelte" />
    </div>
    <p
      class="mx-auto mt-6 flex max-w-2xl items-center justify-center gap-2 text-balance text-center text-muted-foreground text-sm"
    >
      <Icon name="users" size={15} />
      Open this page in a second tab or on another device — you are editing the
      same document, synced through a Cloudflare Durable Object.
    </p>
  </div>
</section>
