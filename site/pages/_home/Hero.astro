---
import Icon from "blume/components/Icon.astro";

const installCommand = "pnpm add edytor";
const phrases = [
  "Slate's flexibility, Svelte's ergonomics",
  "Notion-style blocks, your components",
  "Collaborative from the first keystroke",
  "Offline first, synced when you're back",
  "A Durable Object server included",
  "Plugins that can veto any edit",
  "Built on a Yjs v14 engine",
];
const copyScript = `(()=>{document.addEventListener("click",async(event)=>{const button=event.target.closest("[data-copy-install]");if(!button)return;await navigator.clipboard.writeText(button.dataset.copyInstall);const label=button.querySelector("[data-copy-label]");if(!label)return;const previous=label.textContent;label.textContent="Copied";setTimeout(()=>{label.textContent=previous;},1600);});})();`;
const phraseScript = `(()=>{const phrases=${JSON.stringify(phrases)};const text=document.querySelector("[data-hero-phrase]");if(!text||text.dataset.rotating==="true"||window.matchMedia("(prefers-reduced-motion: reduce)").matches)return;text.dataset.rotating="true";let index=0;const interval=window.setInterval(()=>{if(!text.isConnected){window.clearInterval(interval);return;}text.classList.add("opacity-0");window.setTimeout(()=>{index=(index+1)%phrases.length;text.textContent=phrases[index];text.classList.remove("opacity-0");},180);},2800);})();`;
---

<section class="text-center">
  <div
    class="inline-flex min-w-[17rem] items-center justify-center gap-2 rounded-full border border-border bg-muted/40 px-3 py-1.5 text-muted-foreground text-xs"
  >
    <span class="size-1.5 rounded-full bg-accent"></span>
    <span class="transition-opacity duration-150" data-hero-phrase>
      {phrases[0]}
    </span>
  </div>

  <h1
    class="mx-auto mt-7 max-w-4xl text-balance font-medium text-4xl tracking-tight sm:text-5xl lg:text-7xl"
  >
    <span class="block">The block editor for Svelte</span>
    <span class="block text-muted-foreground">collaborative by default.</span>
  </h1>

  <p
    class="mx-auto mt-6 max-w-2xl text-balance text-lg text-muted-foreground leading-relaxed"
  >
    Render every block with your own Svelte snippets, hook into every edit
    with plugins, and let people write together — online, offline, and across
    tabs — on a Yjs v14 engine with a Durable Object server.
  </p>

  <div class="mx-auto mt-9 flex max-w-md items-center rounded-full border border-border bg-background p-1.5 pl-5 shadow-lg shadow-foreground/[0.04]">
    <span class="mr-3 select-none font-mono text-muted-foreground text-sm">$</span>
    <code class="min-w-0 flex-1 text-left font-mono text-sm">{installCommand}</code>
    <button
      class="inline-flex h-9 cursor-pointer items-center gap-2 rounded-full bg-foreground px-4 font-medium text-background text-sm transition-opacity hover:opacity-85"
      data-copy-install={installCommand}
      type="button"
    >
      <Icon name="copy-plus" size={15} />
      <span data-copy-label>Copy</span>
    </button>
  </div>

  <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
    <a
      class="inline-flex h-10 items-center gap-2 rounded-full bg-foreground px-5 font-medium text-background text-sm transition-opacity hover:opacity-85"
      href="/docs/getting-started/quick-start"
    >
      Start building
      <Icon name="arrow-right" size={15} />
    </a>
    <a
      class="inline-flex h-10 items-center gap-2 rounded-full border border-border px-5 font-medium text-muted-foreground text-sm transition-colors hover:bg-muted hover:text-foreground"
      href="https://github.com/beynar/edytor"
      rel="noreferrer"
      target="_blank"
    >
      <Icon name="github" size={16} />
      View on GitHub
    </a>
  </div>
</section>

<script is:inline set:html={copyScript} />
<script is:inline set:html={phraseScript} />
