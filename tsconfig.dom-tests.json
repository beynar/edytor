{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "src/tests/jsx",
		"allowJs": true,
		"checkJs": false,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"],
			"$registry": ["./registry"],
			"$registry/*": ["./registry/*"]
		},
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"types": ["vite/client"]
	},
	"include": [
		"registry/edytor.d.ts",
		"src/app.d.ts",
		"src/jsx/**/*.ts",
		"src/tests/dom/**/*.ts",
		"src/tests/dom/**/*.tsx",
		"src/tests/dom/**/*.svelte",
		"src/tests/fixtures/**/*.ts",
		"src/tests/fixtures/**/*.tsx",
		"src/tests/jsx/**/*.ts",
		"src/tests/jsx/**/*.tsx",
		"src/tests/test.utils.ts",
		"src/lib/block/**/*.ts",
		"src/lib/components/**/*.svelte",
		"src/lib/constants.ts",
		"src/lib/edytor.svelte.ts",
		"src/lib/edytor.utils.ts",
		"src/lib/events/**/*.ts",
		"src/lib/hotkeys.ts",
		"src/lib/plugins.ts",
		"src/lib/plugins/**/*.d.ts",
		"src/lib/plugins/**/*.svelte",
		"src/lib/selection/**/*.ts",
		"src/lib/text/**/*.ts",
		"src/lib/utils.ts",
		"src/lib/utils/**/*.ts"
	],
	"exclude": [
		// Vendored upstream JS is checked by tsconfig.vendor-dts.json —
		// the same exclusion tsconfig.json already declares.
		"src/lib/crdt/vendor/**",
		// The forked drag and drop is read through its upstream declarations.
		"src/lib/dnd/vendor/**"
	]
}
