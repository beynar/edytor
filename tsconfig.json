{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "src/jsx",
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		// Plumbing members tagged `@internal` stay out of the emitted
		// declarations (`svelte-package`; `api/*.api.md` is the result).
		"stripInternal": true
	},
	"include": ["src/app.d.ts", "src/**/*.ts", "src/**/*.js", "src/**/*.svelte"],
	"exclude": [
		"src/tests/**",
		"src/lib/crdt/vendor/**",
		// `engine.js` is the runtime-only shim that pulls the vendored v14
		// sources into the bundle. Its type surface is declared by the adjacent
		// `engine.d.ts` (`Y: EngineApi`); keeping the .js out of the program
		// stops vendored JS from being checked here (it is checked by
		// tsconfig.vendor-dts.json instead).
		"src/lib/crdt/engine.js"
	]
}
