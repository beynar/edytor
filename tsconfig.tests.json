{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "src/tests/jsx",
		"allowJs": true,
		"checkJs": false,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"]
		},
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"types": ["vite/client"]
	},
	"include": [
		"src/app.d.ts",
		"src/tests/test.utils.ts",
		// The API rows that run without node types (public-surface.test.ts runs node tooling).
		"src/tests/api/command-surface.test.ts",
		"src/tests/api/naming.test.ts",
		"src/tests/api/retired-aliases.test.ts",
		"src/tests/fixtures/**/*.ts",
		"src/tests/fixtures/**/*.tsx",
		"src/tests/jsx/**/*.ts",
		"src/tests/jsx/**/*.tsx",
		"src/lib/block/**/*.ts",
		"src/lib/edytor.svelte.ts",
		"src/lib/edytor.utils.ts",
		"src/lib/events/**/*.ts",
		"src/lib/hotkeys.ts",
		"src/lib/plugins.ts",
		"src/lib/plugins/**/*.d.ts",
		"src/lib/plugins/**/*.svelte",
		"src/lib/selection/**/*.ts",
		"src/lib/text/**/*.ts",
		"src/lib/utils/**/*.ts"
	],
	"exclude": [
		// Vendored upstream JS is checked by tsconfig.vendor-dts.json —
		// the same exclusion tsconfig.json already declares.
		"src/lib/crdt/vendor/**"
	]
}
