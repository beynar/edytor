{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"lib": ["ES2024", "WebWorker"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowJs": false,
		"checkJs": false,
		"noEmit": true,
		"types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
		// The site's demo room (site/room) imports the package: read it from source.
		"paths": {
			"$lib": ["../../src/lib"],
			"$lib/*": ["../../src/lib/*"],
			"edytor/cloudflare": ["../../src/lib/cloudflare/index.ts"]
		}
	},
	"include": ["./**/*.ts"],
	"exclude": []
}
