---
import Icon from "blume/components/Icon.astro";

const capabilities = [
  { description: "Paragraphs, headings, lists, todos, quotes, callouts, toggles", href: "/docs/plugins/rich-text", icon: "pilcrow", title: "Rich text blocks" },
  { description: "Bold, italic, links, colors, and your own marks by tag", href: "/docs/customization/marks", icon: "bold", title: "Marks" },
  { description: "Define kinds with snippets, presets, islands, and voids", href: "/docs/customization/blocks", icon: "blocks", title: "Custom blocks" },
  { description: "Non-editable atoms such as mentions, rendered by you", href: "/docs/customization/inline-blocks", icon: "at-sign", title: "Inline blocks" },
  { description: "Handles, drop indicators, keyboard moves, and nesting", href: "/docs/plugins/block-handles", icon: "grip-vertical", title: "Drag and drop" },
  { description: "Insert any kind from a filtered command menu", href: "/docs/plugins/slash-menu", icon: "square-slash", title: "Slash menu" },
  { description: "Format a selection from a floating toolbar", href: "/docs/plugins/toolbar", icon: "text-cursor-input", title: "Selection toolbar" },
  { description: "Type # or - to turn a line into a heading or a list", href: "/docs/plugins/markdown-shortcuts", icon: "hash", title: "Markdown shortcuts" },
  { description: "Syntax highlighting with TanStack Highlight", href: "/docs/plugins/code", icon: "code", title: "Code blocks" },
  { description: "A full keymap you can extend, override, or disable", href: "/docs/customization/hotkeys", icon: "keyboard", title: "Hotkeys" },
  { description: "Veto or replace any command before it writes", href: "/docs/plugins/writing-plugins", icon: "plug", title: "Plugin hooks" },
  { description: "Undo that keeps what others wrote", href: "/docs/editor/history", icon: "undo-2", title: "Collaborative undo" },
  { description: "Model-driven copy, cut, paste, and HTML import", href: "/docs/editor/clipboard", icon: "clipboard", title: "Clipboard" },
  { description: "Remote cursors and selections from awareness", href: "/docs/collaboration/presence", icon: "mouse-pointer-2", title: "Presence" },
  { description: "IndexedDB copy, cross-tab sync, offline edits", href: "/docs/collaboration/persistence", icon: "hard-drive", title: "Offline persistence" },
  { description: "Deploy the room on Durable Objects in minutes", href: "/docs/server/quick-start", icon: "server", title: "Durable Object room" },
  { description: "Attach a document to any Durable Object, keep it in R2, KV or D1", href: "/docs/server/extending", icon: "database", title: "Your Durable Object" },
  { description: "Use the document in Node, SSR, or a Worker", href: "/docs/collaboration/documents", icon: "cpu", title: "Headless documents" },
];
---

<section>
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-balance font-medium text-3xl tracking-tight sm:text-5xl">
      Everything from a paragraph to a workspace.
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-balance text-muted-foreground">
      The editing features people expect, and the extension points to build the
      ones they don't yet.
    </p>
  </div>

  <ul
    class="mx-auto mt-12 grid max-w-6xl list-none gap-x-12 gap-y-7 sm:grid-cols-2 lg:grid-cols-3"
  >
    {
      capabilities.map((capability) => (
        <li>
          <a class="group flex items-start gap-3" href={capability.href}>
            <Icon
              class="mt-0.5 shrink-0 text-muted-foreground/50 transition-colors group-hover:text-accent"
              name={capability.icon}
              size={18}
            />
            <span class="min-w-0">
              <span class="block font-medium text-sm transition-colors group-hover:text-accent">
                {capability.title}
              </span>
              <span class="mt-1 block text-muted-foreground text-xs leading-relaxed">
                {capability.description}
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="mt-10 text-center">
    <a
      class="inline-flex h-10 items-center gap-2 rounded-full border border-border bg-background px-5 font-medium text-sm transition-colors hover:bg-muted"
      href="/docs"
    >
      Read the documentation
      <Icon name="arrow-right" size={15} />
    </a>
  </div>
</section>
